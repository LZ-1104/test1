{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake Debug (OpenOCD + DAPLink)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32F103VETx",
            "interface": "swd",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f1x.cfg"
            ],
            "preLaunchTask": "CMake: build",
            "postRestartCommands": [
                "monitor reset halt"
            ]
        }
    ]
}
